{
  "name": "@companyio/platform-ui",
  "version": "0.1.4",
  "description": "Shared product shell primitives for web, desktop, and mobile-adjacent React apps",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "generate-icons": "node scripts/generate-icons.mjs",
    "build": "pnpm run clean && pnpm run generate-icons && tsc",
    "test": "tsc --noEmit"
  },
  "dependencies": {
    "@companyio/auth-client": "workspace:*",
    "@companyio/auth-contracts": "workspace:*",
    "@companyio/auth-react": "workspace:*",
    "@companyio/shared-types": "workspace:*",
    "@fullcalendar/core": "^6.1.19",
    "@fullcalendar/daygrid": "^6.1.19",
    "@fullcalendar/interaction": "^6.1.19",
    "@fullcalendar/list": "^6.1.19",
    "@fullcalendar/react": "^6.1.19",
    "@fullcalendar/timegrid": "^6.1.19",
    "@react-jvectormap/core": "^1.0.4",
    "@react-jvectormap/world": "^1.1.2",
    "apexcharts": "^4.7.0",
    "clsx": "^2.1.1",
    "flatpickr": "^4.6.13",
    "react-apexcharts": "^1.8.0",
    "react-dropzone": "^14.3.8",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.2",
    "swiper": "^11.2.10",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@svgr/cli": "^8.1.0",
    "@types/react": "^18.2.0",
    "react": "^18.2.0",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  }
}
