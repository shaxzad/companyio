{
  "name": "@companyio/platform-ui",
  "version": "0.1.12",
  "description": "Shared product shell primitives for web, desktop, and mobile-adjacent React apps",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./styles/tailwind.css"
  },
  "files": [
    "dist",
    "styles",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css",
    "./src/index.tsx",
    "./dist/index.js"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "generate-icons": "node scripts/generate-icons.mjs",
    "build": "npm run clean && npm run generate-icons && tsc && cp src/index.css dist/index.css",
    "prepublishOnly": "npm run build",
    "test": "tsc --noEmit && vitest run"
  },
  "dependencies": {
    "@companyio/auth-client": "workspace:*",
    "@companyio/auth-contracts": "workspace:*",
    "@companyio/auth-react": "workspace:*",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^0.511.0",
    "@fullcalendar/core": "^6.1.19",
    "@fullcalendar/daygrid": "^6.1.19",
    "@fullcalendar/interaction": "^6.1.19",
    "@fullcalendar/list": "^6.1.19",
    "@fullcalendar/react": "^6.1.19",
    "@fullcalendar/timegrid": "^6.1.19",
    "@react-jvectormap/core": "^1.0.4",
    "@react-jvectormap/world": "^1.1.2",
    "apexcharts": "^4.7.0",
    "clsx": "^2.1.1",
    "flatpickr": "^4.6.13",
    "react-apexcharts": "^1.8.0",
    "react-dropzone": "^14.3.8",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.18.2",
    "sonner": "^2.0.8",
    "swiper": "^11.2.10",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@svgr/cli": "^8.1.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  },
  "peerDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "tailwindcss": "^4.0.0"
  }
}
